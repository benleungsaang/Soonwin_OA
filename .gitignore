# ===================== 基础通用忽略 (所有项目通用) =====================
# 系统自动生成的缓存/临时文件
.DS_Store
Thumbs.db
*.tmp
*.temp
*~

# 编辑器/IDE 配置文件 (你的项目里有 .vscode)
.vscode/
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project

# ===================== Vue前端项目专属忽略 (soonwin-oa-VUE-FrontEnd) =====================
# node依赖包 (项目里有 node_modules，必忽略，体积超大)
node_modules/

# 环境变量文件 (前端环境配置，私密信息)
.env
.env.local
.env.development.local
.env.production.local
.env.test.local

# 打包构建产物
dist/
build/
out/


# 日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 缓存文件
.eslintcache
*.tgz

# ===================== Python后端项目专属忽略 (soonwin-os-Python-Server) =====================
# Python虚拟环境 (项目里有 venv，必忽略)
venv/
env/
ENV/
env/
.venv/
env3/

# Python编译缓存文件 (项目里有 __pycache__，必忽略)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 常见的多媒体文件
*.mp4
*.avi
*.mkv
*.mov
*.jpg
*.png
*.psd

# 数据库文件
# - soonwin_oa_dev.db 入库（开发种子，让公司/家里 clone 后能直接启动 dev mode）
# - soonwin_oa.db 忽略（生产库，有真实业务数据，不入库）
soonwin_oa.db
# 其他 db 文件也忽略（如临时 backup）
*.backup_*
data/
*.sqlite
*.sqlite3
*.backup_*
data/

# 迁移文件缓存
migrations/versions/

# Python日志/临时文件
*.log
*.pid
*.seed
*.pid.lock

# 依赖安装清单 【注意：requirements.txt 不要忽略！要提交】

# ===================== 项目文档/文件 针对性忽略 =====================
# 你的项目里有大量PDF/TXT/MD技术文档，按需忽略规则：
# ✅ 建议保留：技术文档 .md 后缀文件 (比如 机器验收系统技术文档.md)
# ✅ 建议忽略：所有PDF、TXT 格式的技术文档/方案文档 (体积大+无需版本控制)
*.pdf
# *.txt

# ===================== 其他补充忽略 =====================
# 本地配置文件
.local
*.local.conf



# python 服务器静态文件
assets/
nginx-1.28.1/
nginx_pid/
其它文件/
# 辅助脚本/ 整个目录是个人工作笔记/临时脚本，不入库（全部子目录）
辅助脚本/
# 取反保留：Python后端项目的assets/TemplateImg目录（及内部所有内容）
!assets/TemplateImg/
!assets/TemplateImg/**/*

# ===================== 补充：忽略历史记录目录 =====================
# Vue前端项目历史记录
soonwin-oa-VUE-FrontEnd/.history/
# Python后端项目历史记录
soonwin-os-Python-Server/.history/

# ===================== 独立子项目（保持各自 git 历史） =====================
# 货柜排布/ 目录是独立 git 仓库，主仓库不追踪其内容
# 它的 Container.html 会按需复制到 soonwin-oa-VUE-FrontEnd/public/
货柜排布/